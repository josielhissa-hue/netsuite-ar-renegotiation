<customrecordtype scriptid="customrecord_jh_rng_policy">
  <recordname>JH Renegotiation Policy</recordname>
  <accesstype>CUSTRECORDENTRYPERM</accesstype>
  <allowattachments>T</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlineediting>F</allowinlineediting>
  <allowquicksearch>T</allowquicksearch>
  <enablemailmerge>F</enablemailmerge>
  <includename>F</includename>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <showid>T</showid>
  <shownotes>T</shownotes>
  <customrecordcustomfields>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_penalty_pct">
      <fieldtype>PERCENT</fieldtype>
      <label>Late penalty (%)</label>
      <ismandatory>T</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_late_rate">
      <fieldtype>PERCENT</fieldtype>
      <label>Late interest per month (%)</label>
      <ismandatory>T</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_late_mode">
      <fieldtype>TEXT</fieldtype>
      <label>Late interest mode (SIMPLE or COMPOUND)</label>
      <ismandatory>T</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_fin_rate">
      <fieldtype>PERCENT</fieldtype>
      <label>Maximum financing rate per month (%)</label>
      <ismandatory>T</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_max_installments">
      <fieldtype>INTEGER</fieldtype>
      <label>Maximum installments</label>
      <ismandatory>T</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_min_down_pct">
      <fieldtype>PERCENT</fieldtype>
      <label>Minimum down payment (%)</label>
      <ismandatory>F</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_discount_base">
      <fieldtype>TEXT</fieldtype>
      <label>Discount base (CHARGES or TOTAL)</label>
      <ismandatory>T</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_default_method">
      <fieldtype>TEXT</fieldtype>
      <label>Default method (PRICE, SAC or FLAT)</label>
      <ismandatory>F</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_tiers">
      <fieldtype>CLOBTEXT</fieldtype>
      <label>Approval tiers (JSON)</label>
      <ismandatory>T</ismandatory>
      <displaytype>NORMAL</displaytype>
      <storevalue>T</storevalue>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
      <help>Example: [{"level":1,"maxDiscountPct":5,"maxInstallments":6,"roles":[1030]}]</help>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_jh_rngp_grace_days">
      <fieldtype>INTEGER</fieldtype>
